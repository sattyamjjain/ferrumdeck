# FerrumDeck .gitignore
# ======================

# =============================================================================
# Rust
# =============================================================================
/target/
**/*.rs.bk
Cargo.lock
# Keep Cargo.lock for applications, but it's generated by workspace

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# Python lib directories (not nextjs/src/lib)
/lib/
/lib64/
python/**/lib/
!nextjs/src/lib/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/

# uv
.uv/
uv.lock
# Keep uv.lock for reproducibility - actually we want this
!uv.lock

# pytest
.pytest_cache/
.coverage
htmlcov/

# Type checking
.pyright/
.mypy_cache/

# Ruff
.ruff_cache/

# =============================================================================
# IDE / Editor
# =============================================================================
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# =============================================================================
# Environment
# =============================================================================
.env
.env.local
.env.*.local
!.env.example

# Secrets (never commit)
*.pem
*.key
credentials.json
secrets.yaml
secrets.json

# =============================================================================
# Build / Artifacts
# =============================================================================
*.log
*.tmp
*.temp

# =============================================================================
# Docker
# =============================================================================
docker-compose.override.yaml
docker-compose.override.yml

# =============================================================================
# Database
# =============================================================================
*.sqlite
*.sqlite3
*.db

# =============================================================================
# Eval outputs (generated)
# =============================================================================
# Local ad-hoc benchmark output stays ignored -- it is unverified, machine-local,
# and must not drift into the published record by way of a stray `git add -A`.
#
# The nightly's own suite reports (`eval_*.json`) are different: they are the
# evidence docs/eval-health.md is generated from, so they are un-ignored and
# commit like any other file. Previously they were ignored and force-added,
# which is how a plain `git add -A` silently dropped one and a false "the
# report is committed" claim reached the 0.8.7 notes.
#
# The three headline benchmarks (`asb`, `injection_defense`,
# `governed-benchmark`) are un-ignored for the same reason `eval_*.json` is, and
# it is worth stating because the "unverified, machine-local" caveat above looks
# like it should apply to them and does not.
#
# They are DETERMINISTIC and OFFLINE -- seeded, no LLM, no network. A local run
# and a CI run produce byte-identical figures, which is precisely what
# `make reproduce-readme-figures` asserts on every published number. So there is
# no machine-local drift for the ignore rule to protect against.
#
# What the ignore rule DID cost: these reports are the evidence
# docs/eval-health.md is generated from (it reads `git ls-files`, so an
# untracked report is invisible to it), and committing one required `git add -f`
# every time. Between 2026-08-10 and 2026-08-26 exactly two runs were committed,
# while ci.yml ran all three on every push and PR. The page reported "2
# consecutive passes" for evals that had in fact run hundreds of times -- the
# evidence was stale, not the eval. That is the same failure the 0.8.7 note
# describes for `eval_*.json`: a force-added file is one a plain `git add -A`
# silently drops.
#
# The `*-20260810.json` reports predate all of this and stay tracked anyway: an
# ignore rule does not untrack an already-committed file.
evals/reports/*.json
evals/reports/*.html
evals/reports/*.md
!evals/reports/eval_*.json
!evals/reports/asb-*.json
!evals/reports/asb-*.md
!evals/reports/injection_defense-*.json
!evals/reports/injection_defense-*.md
!evals/reports/governed-benchmark-*.json
!evals/reports/governed-benchmark-*.md

# =============================================================================
# Artifacts (runtime outputs)
# =============================================================================
artifacts/

# =============================================================================
# OS
# =============================================================================
Thumbs.db

# =============================================================================
# Claude Code auto-memory
# =============================================================================
.claude/auto-memory/dirty-files
.claude-flow/

# =============================================================================
# Playwright MCP (test screenshots)
# =============================================================================
.playwright-mcp/

# =============================================================================
# Helm — vendored dependency tarballs (re-pulled via `helm dependency update`)
# =============================================================================
deploy/helm/*/charts/

# =============================================================================
# In-flight planning / scratch artifacts (session logs, scan state) — must not
# be committed to a public repo. See SECURITY.md for the security-review
# disposition; these are working scratch, not deliverables.
# =============================================================================
security-scan/
nextjs/refactor/

# JUnit reports from `make test-live-stack` / the live-stack CI job (never committed;
# scripts/check_live_stack_results.py reads them in place).
live-stack-results.xml
pytest-*.xml
