# FerrumDeck Gateway Dockerfile
# Multi-stage build for minimal production image

# =============================================================================
# Stage 1: Build
# =============================================================================
# Base pinned by digest (not tag) for reproducible, tamper-evident builds.
# rust:1.85-bookworm as of 2026-08-12.
FROM rust:1.85-bookworm@sha256:e51d0265072d2d9d5d320f6a44dde6b9ef13653b035098febd68cce8fa7c0bc4 AS builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy Cargo manifests first for layer caching. Cargo.lock is gitignored in this
# repo, so it is NOT copied here; the release build below generates it. This lets
# the image build from any clone (CI or a stranger) with no pre-existing lockfile.
COPY Cargo.toml ./
COPY rust/crates/ rust/crates/
COPY rust/services/ rust/services/
COPY db/migrations/ db/migrations/

# Build in release mode
RUN cargo build --release --package gateway

# =============================================================================
# Stage 2: Runtime
# =============================================================================
# Runtime base pinned by digest. debian:bookworm-slim as of 2026-08-12.
FROM debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241 AS runtime

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && adduser --disabled-password --gecos "" --uid 1000 ferrumdeck

WORKDIR /app

# Copy the compiled binary from builder
COPY --from=builder /app/target/release/gateway /app/gateway

# Bake the committed eval reports into the image so a deployed gateway serves
# GET /v1/evals/* with real data instead of 501 NO_EVAL_STORE (issue #7). These
# are deterministic, offline run records committed under evals/reports/ (produced
# by `make eval-asb` / `eval-injection-defense` / `bench-governed`). FD_EVALS_REPORTS_DIR
# points the reader straight at them rather than relying on the working directory.
COPY evals/reports/ /app/evals/reports/
ENV FD_EVALS_REPORTS_DIR=/app/evals/reports

# Set ownership
RUN chown -R ferrumdeck:ferrumdeck /app

USER ferrumdeck

# Health check endpoint (use static port - ENV vars don't expand in HEALTHCHECK)
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Expose the gateway port
EXPOSE ${GATEWAY_PORT:-8080}

# Environment variables (can be overridden)
ENV RUST_LOG=info,tower_http=debug
ENV GATEWAY_PORT=8080

# Run the gateway
CMD ["./gateway"]
